{
  "name": "potree",
  "version": "2.0.0",
  "type": "module",
  "description": "WebGL 2.0 point cloud viewer",
  "keywords": [
    "point",
    "cloud",
    "pointcloud",
    "octree",
    "entwine",
    "viewer",
    "threejs",
    "webgl",
    "webgl2",
    "browser",
    "tool",
    "lidar",
    "las",
    "laz"
  ],
  "main": "./build/potree/potree.js",
  "module": "./build/potree/potree.js",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run scripts/dev.ts",
    "start": "bun run dev",
    "clean": "rm -rf build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0"
  },
  "author": "Markus Schütz",
  "license": "BSD-2-CLAUSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/potree/potree.git"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
